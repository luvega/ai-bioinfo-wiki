{
  "readableLineLength": true,
  "defaultViewMode": "preview",
  "livePreview": true,
  "showLineNumber": true,
  "showInlineTitle": true,
  "showViewHeader": true,
  "showUnsupportedFiles": false,
  "useMarkdownLinks": true,
  "newLinkFormat": "relative",
  "alwaysUpdateLinks": true,
  "attachmentFolderPath": "wiki/assets",
  "useTab": false,
  "tabSize": 2,
  "promptDelete": true,
  "trashOption": "system",
  "userIgnoreFilters": [
    "pdf_originals/",
    "sources/PDF_Library/",
    "sources/AIDD_Bioinformatics/",
    "raw/AIDD_Bioinformatics/",
    ".git/",
    "__pycache__/",
    "scripts/__pycache__/"
  ]
}
