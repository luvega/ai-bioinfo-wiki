---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { coursewareWeeks } from '../data/coursebook';
import { parseStoryboardRows, storyboardReviewMetrics } from '../lib/storyboard';
import { withBase } from '../lib/paths';

const repoRoot = fileURLToPath(new URL('../../../', import.meta.url));
const priorityWeeks = new Set([3, 5, 8, 11, 12, 13, 15, 16, 18]);

const reviewRows = coursewareWeeks.map((week) => {
  const storyboardPath = resolve(repoRoot, week.storyboardSource);
  const storyboardMarkdown = existsSync(storyboardPath) ? readFileSync(storyboardPath, 'utf-8') : '';
  const rows = parseStoryboardRows(storyboardMarkdown);
  const metrics = storyboardReviewMetrics(rows);
  const priority = priorityWeeks.has(week.week);
  const needsAttention = metrics.rowCount !== 40
    || metrics.completeStudentActions !== 40
    || metrics.totalMinutes !== 90
    || metrics.shortRows > 0
    || metrics.genericEvidenceRows > 0
    || (priority && (metrics.duplicateActionTitles > 0 || metrics.maxTeacherRepeat > 3));
  return { week, metrics, priority, needsAttention };
});
---

<BaseLayout title="Courseware / Teaching Plan" description="18 周教学计划与 PPT storyboard 审核入口">
  <PageHeader
    eyebrow="Courseware"
    title="Teaching Plan 与 Storyboard 审核台"
    intro="本入口承载 18 周 90 分钟教学计划、40 页主干 storyboard、Student action、Timing、课堂产物和 PPT 未完成边界。教材正文请回到 Coursebook。"
  />

  <section class="section">
    <div class="section-inner split">
      <article class="info-panel">
        <h2>双主线分工</h2>
        <ul class="content-list">
          <li><strong>Coursebook：</strong>教材章节、知识体系、知识图谱和素材资产。</li>
          <li><strong>Courseware：</strong>教学计划、课堂时间切分、学生动作、storyboard 审核和 PPT 前置检查。</li>
          <li><strong>teaching_plan.md：</strong>回答“90 分钟怎么教”。</li>
          <li><strong>ppt_storyboard.md：</strong>回答“每页投屏源稿怎么呈现”。</li>
        </ul>
      </article>
      <article class="info-panel">
        <h2>审核口径</h2>
        <p>本页直接解析每周 storyboard 指标，并要求所有周次都有独立 teaching plan。40 页源稿用于后续裁剪，不表示 PPTX、PNG 或视觉 QA 完成。</p>
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Review Matrix</p>
        <h2>18 周教学计划与 storyboard 审核矩阵</h2>
      </div>
      <div class="chapter-table-wrap">
        <table class="data-table chapter-table review-table">
          <thead>
            <tr>
              <th>周次</th>
              <th>标题</th>
              <th>优先级</th>
              <th>教学计划</th>
              <th>页数</th>
              <th>学生动作</th>
              <th>时间</th>
              <th>重复/短页</th>
              <th>证据 note</th>
              <th>入口</th>
            </tr>
          </thead>
          <tbody>
            {reviewRows.map(({ week, metrics, priority, needsAttention }) => (
              <tr class={needsAttention ? 'needs-review' : ''}>
                <td>Week {String(week.week).padStart(2, '0')}</td>
                <td>
                  <strong>{week.title}</strong>
                  <p>{week.summary}</p>
                </td>
                <td><span class={`status-pill ${priority ? 'accent' : ''}`}>{priority ? '重点精修' : '字段完整'}</span></td>
                <td><code>{week.teachingPlanSource}</code></td>
                <td>{metrics.rowCount}/40</td>
                <td>{metrics.completeStudentActions}/40</td>
                <td>{metrics.totalMinutes} min</td>
                <td>标题重复 {metrics.duplicateActionTitles}；讲解最大重复 {metrics.maxTeacherRepeat}；短页 {metrics.shortRows}</td>
                <td>泛化 {metrics.genericEvidenceRows}</td>
                <td><a class="text-link" href={withBase(week.page)}>逐周审核</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
