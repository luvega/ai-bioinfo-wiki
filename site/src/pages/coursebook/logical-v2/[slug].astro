---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { coursebookChapters } from '../../../data/coursebook';
import { withBase } from '../../../lib/paths';

export function getStaticPaths() {
  return coursebookChapters.map((chapter) => ({
    params: { slug: chapter.slug },
    props: { chapter }
  }));
}

const { chapter } = Astro.props;
const redirectUrl = withBase(chapter.page);
---

<BaseLayout title="Coursebook 路径已更新" description="教材章节路径已更新">
  <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
  <section class="section">
    <div class="section-inner">
      <article class="info-panel">
        <h1>路径已更新</h1>
        <p>本章已进入新的 Coursebook 章节路径。</p>
        <p><a class="text-link" href={redirectUrl}>打开第 {chapter.chapter} 章 {chapter.title}</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
