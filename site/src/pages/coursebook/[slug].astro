---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { resolve } from 'node:path';
import { coursebookChapters } from '../../data/coursebook';
import { withBase } from '../../lib/paths';
import { renderSimpleMarkdown } from '../../lib/simpleMarkdown';

type RedirectProps = {
  redirectTo: string;
};

type ChapterProps = {
  chapter: typeof coursebookChapters[number];
};

export function getStaticPaths() {
  const chapterPaths = coursebookChapters.map((chapter) => ({
    params: { slug: chapter.slug },
    props: { chapter }
  }));
  const legacyWeekPaths = Array.from({ length: 18 }, (_, index) => {
    const week = index + 1;
    return {
      params: { slug: `week-${String(week).padStart(2, '0')}` },
      props: { redirectTo: `/weeks/week-${String(week).padStart(2, '0')}` }
    };
  });
  return [...chapterPaths, ...legacyWeekPaths];
}

const props = Astro.props as ChapterProps | RedirectProps;
const isRedirect = 'redirectTo' in props;
const redirectUrl = isRedirect ? withBase(props.redirectTo) : '';
const chapter = 'chapter' in props ? props.chapter : coursebookChapters[0];
const previousChapter = coursebookChapters.find((item) => item.chapter === chapter.chapter - 1);
const nextChapter = coursebookChapters.find((item) => item.chapter === chapter.chapter + 1);
const repoRoot = fileURLToPath(new URL('../../../../', import.meta.url));
const chapterPath = resolve(repoRoot, chapter.chapterSource);

if (!isRedirect && !existsSync(chapterPath)) {
  throw new Error(`Missing Coursebook chapter source: ${chapter.chapterSource}`);
}

const chapterMarkdown = !isRedirect ? readFileSync(chapterPath, 'utf-8') : '';
const chapterHtml = renderSimpleMarkdown(chapterMarkdown);
const knowledgeGraphPath = resolve(repoRoot, chapter.knowledgeGraph);
const knowledgeGraphSource = !isRedirect && existsSync(knowledgeGraphPath) ? readFileSync(knowledgeGraphPath, 'utf-8') : '';
const processDiagrams = !isRedirect ? chapter.processDiagrams.map((diagramPath) => {
  const fullPath = resolve(repoRoot, diagramPath);
  return {
    path: diagramPath,
    source: existsSync(fullPath) ? readFileSync(fullPath, 'utf-8') : ''
  };
}) : [];
const sourceWeekLinks = !isRedirect ? chapter.sourceWeeks.map((path) => {
  const match = path.match(/week_(\d{2})/);
  return {
    path,
    href: match ? `/weeks/week-${match[1]}` : ''
  };
}) : [];
---

<BaseLayout title={isRedirect ? 'Coursebook 路径已更新' : `第 ${chapter.chapter} 章 ${chapter.title}`} description={isRedirect ? '旧 Coursebook 周次路径已转向 Weeks' : chapter.summary}>
  {isRedirect ? (
    <>
      <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
      <section class="section">
        <div class="section-inner">
          <article class="info-panel">
            <h1>路径已更新</h1>
            <p>该周次入口已转入 Weeks 页面。</p>
            <p><a class="text-link" href={redirectUrl}>打开对应周次</a></p>
          </article>
        </div>
      </section>
    </>
  ) : (
  <>
  <section class="week-hero sample-hero">
    <div class="section-inner">
      <p class="section-label">Coursebook · Chapter {String(chapter.chapter).padStart(2, '0')} · {chapter.part}</p>
      <h1>{chapter.title}</h1>
      <p>{chapter.coreQuestion}</p>
      <ul class="tag-list">
        <li>{chapter.status}</li>
        <li>{chapter.chapterFocus}</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="section-inner split">
      <article class="info-panel">
        <h2>本章定位</h2>
        <p><strong>章节功能：</strong>{chapter.chapterFocus}</p>
        <p><strong>正文源稿：</strong><code>{chapter.chapterSource}</code></p>
        <p><strong>知识图谱源稿：</strong><code>{chapter.knowledgeGraph}</code></p>
        <p><strong>页面状态：</strong>{chapter.status}</p>
      </article>
      <article class="info-panel">
        <h2>学习证据</h2>
        <ul class="content-list">
          {chapter.learningEvidence.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner split">
      <article class="info-panel">
        <h2>知识图谱</h2>
        <div class="knowledge-map-panel">
          <img src={withBase(chapter.knowledgeMapImage)} alt={`第 ${chapter.chapter} 章知识图谱`} />
        </div>
      </article>
      <article class="info-panel">
        <h2>反向周次</h2>
        <ul class="content-list source-list">
          {sourceWeekLinks.map((item) => (
            <li>
              {item.href ? <a class="text-link" href={withBase(item.href)}>{item.path}</a> : <code>{item.path}</code>}
            </li>
          ))}
        </ul>
        <p class="spaced-list">
          反向周次用于查找课堂材料、教学计划和 storyboard；本页负责教材正文和知识结构。
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <article class="info-panel textbook-body">
        <h2>教材正文</h2>
        <div class="markdown-body" set:html={chapterHtml} />
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner split">
      <article class="info-panel">
        <h2>来源映射</h2>
        <h3>旧教材素材池</h3>
        <ul class="content-list source-list">
          {chapter.sourceChapters.map((path) => <li><code>{path}</code></li>)}
        </ul>
        <h3 class="subhead">知识支持层</h3>
        <ul class="content-list source-list">
          {chapter.knowledgeSources.map((path) => <li><code>{path}</code></li>)}
        </ul>
      </article>
      <article class="info-panel">
        <h2>素材与资产</h2>
        <h3>素材支持层</h3>
        <ul class="content-list source-list">
          {chapter.materialSources.map((path) => <li><code>{path}</code></li>)}
        </ul>
        <h3 class="subhead">课程资产</h3>
        <ul class="content-list source-list">
          {chapter.assetSources.map((path) => <li><code>{path}</code></li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Diagram Sources</p>
        <h2>可视化源文件</h2>
        <p>知识图谱和流程图均保留 Mermaid 源文件，便于后续修改、版本比较和人工核验。</p>
      </div>
      <article class="info-panel">
        <h3>知识图谱 Mermaid</h3>
        <pre class="code-block mermaid-source"><code>{knowledgeGraphSource}</code></pre>
        {processDiagrams.length > 0 && (
          <>
            <h3 class="subhead">流程图 Mermaid</h3>
            {processDiagrams.map((diagram) => (
              <>
                <p><code>{diagram.path}</code></p>
                <pre class="code-block mermaid-source"><code>{diagram.source}</code></pre>
              </>
            ))}
          </>
        )}
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <nav class="next-prev" aria-label="教材章节导航">
        {previousChapter ? <a href={withBase(previousChapter.page)}>← 第 {previousChapter.chapter} 章 {previousChapter.title}</a> : <a href={withBase('/coursebook')}>← 返回 Coursebook</a>}
        {nextChapter ? <a href={withBase(nextChapter.page)}>第 {nextChapter.chapter} 章 {nextChapter.title} →</a> : <a href={withBase('/coursebook')}>返回 Coursebook →</a>}
      </nav>
      <nav class="next-prev compact-nav" aria-label="教学组织入口">
        <a href={withBase('/weeks')}>打开 Weeks</a>
        <a href={withBase('/courseware')}>打开 Courseware</a>
      </nav>
    </div>
  </section>
  </>
  )}
</BaseLayout>
