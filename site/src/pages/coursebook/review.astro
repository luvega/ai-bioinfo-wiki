---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { withBase } from '../../lib/paths';
---

<BaseLayout title="Coursebook Review 已迁移" description="Coursebook 审核入口迁移到 Courseware">
  <PageHeader
    eyebrow="兼容入口"
    title="Coursebook Review 已迁移到 Courseware"
    intro="Coursebook 现在只承载教材章节、知识体系、知识图谱和素材资产。教学计划、Student action、Timing 与 40 页 storyboard 审核表统一进入 Courseware。"
  />

  <section class="section">
    <div class="section-inner split">
      <article class="info-panel">
        <h2>新的审核入口</h2>
        <p>请使用 <a class="text-link" href={withBase('/courseware')}>Courseware / Teaching Plan</a> 审核周次教学计划、90 分钟时间切分、PPT storyboard 和人工去模板化指标。</p>
      </article>
      <article class="info-panel">
        <h2>保留本页的原因</h2>
        <p>本页仅作为旧链接兼容入口，避免历史 Coursebook Review 链接失效；它不再渲染逐页 storyboard 审核表。</p>
      </article>
    </div>
  </section>
</BaseLayout>
