---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { coursebookChapters } from '../data/coursebook';
import { withBase } from '../lib/paths';

const totalChapters = coursebookChapters.length;
const readyCount = coursebookChapters.filter((chapter) => chapter.status === 'coursebook_ready').length;
const sourceCount = new Set(coursebookChapters.flatMap((chapter) => [
  ...chapter.sourceWeeks,
  ...chapter.sourceChapters,
  ...chapter.knowledgeSources,
  ...chapter.materialSources,
  ...chapter.assetSources
])).size;
---

<BaseLayout title="Coursebook" description="医药数据处理与可视化 12 章在线教材">
  <PageHeader
    eyebrow="Coursebook"
    title="医药数据处理与可视化在线教材"
    intro="Coursebook 采用 12 章逻辑结构，按医药问题、数据质量、统计判断、图表表达、组学解释和综合项目组织。18 周教学计划仍在 Weeks 和 Courseware 中查看。"
  />

  <section class="section">
    <div class="section-inner split">
      <div>
        <div class="section-title">
          <p class="section-label">Textbook Structure</p>
          <h2>从医药问题到可复现证据</h2>
          <p>
            12 章正文保存在 <code>course/textbook/logical_v2/chapters/</code>。每章同时保留知识图谱、流程图、来源周次、
            旧教材素材池、知识页、素材页、课程资产和学习证据，便于学生从教材正文回到可核验来源。
          </p>
        </div>
        <div class="metric-row" aria-label="教材建设状态">
          <div class="metric-card">
            <strong>{totalChapters}</strong>
            <span>章教材正文</span>
          </div>
          <div class="metric-card">
            <strong>{readyCount}</strong>
            <span>章 coursebook_ready</span>
          </div>
          <div class="metric-card">
            <strong>{sourceCount}</strong>
            <span>个来源与资产路径</span>
          </div>
        </div>
      </div>
      <article class="info-panel">
        <h2>使用方式</h2>
        <ul class="content-list">
          <li>需要系统复习概念时，从本页进入对应教材章节。</li>
          <li>需要查看 90 分钟教学组织、课堂任务和 storyboard 时，进入 <a class="text-link" href={withBase('/courseware')}>Courseware</a>。</li>
          <li>需要按周次查找课堂材料时，进入 <a class="text-link" href={withBase('/weeks')}>Weeks</a>。</li>
          <li>所有 AI 输出、统计解释、图表图注和组学结论均应回到来源路径核验。</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Chapter Map</p>
        <h2>12 章目录</h2>
        <p>章节顺序体现知识链递进。每章页面均展示核心问题、知识图谱、正文、流程图、素材来源、学习证据和 18 周反向映射。</p>
      </div>
      <div class="chapter-grid">
        {coursebookChapters.map((chapter) => (
          <a class="chapter-card" href={withBase(chapter.page)}>
            <span class="week-kicker">Chapter {String(chapter.chapter).padStart(2, '0')} · {chapter.part}</span>
            <h3>{chapter.title}</h3>
            <p>{chapter.summary}</p>
            <div class="status-row">
              <span class="status-pill">{chapter.status}</span>
              <span class="status-pill accent">{chapter.chapterFocus}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Source Trace</p>
        <h2>章节来源总览</h2>
        <p>下表用于快速查看每章的核心问题、来源周次和学习证据。详细来源路径在各章页面内展开。</p>
      </div>
      <div class="chapter-table-wrap">
        <table class="data-table chapter-table">
          <thead>
            <tr>
              <th>章</th>
              <th>标题</th>
              <th>核心问题</th>
              <th>来源周次</th>
              <th>学习证据</th>
              <th>入口</th>
            </tr>
          </thead>
          <tbody>
            {coursebookChapters.map((chapter) => (
              <tr id={`chapter-${String(chapter.chapter).padStart(2, '0')}`}>
                <td>{chapter.chapter}</td>
                <td><strong>{chapter.title}</strong><p>{chapter.part}</p></td>
                <td>{chapter.coreQuestion}</td>
                <td>
                  <ul class="content-list source-list">
                    {chapter.sourceWeeks.map((path) => <li><code>{path}</code></li>)}
                  </ul>
                </td>
                <td>
                  <ul class="content-list">
                    {chapter.learningEvidence.map((item) => <li>{item}</li>)}
                  </ul>
                </td>
                <td><a class="text-link" href={withBase(chapter.page)}>打开本章</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
