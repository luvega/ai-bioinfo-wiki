---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { coursebookChapters, sampleChapters } from '../data/coursebook';
import { withBase } from '../lib/paths';

const totalChapters = coursebookChapters.length;
const sampleCount = sampleChapters.length;
---

<BaseLayout title="Coursebook" description="医药数据处理与可视化在线教材目录">
  <PageHeader
    eyebrow="Coursebook"
    title="在线教材目录"
    intro="Coursebook 以 18 周课堂为骨架，按课堂主素材、支撑素材、拓展素材和教师备课素材分层组织。当前 18 章均已扩写为教材源稿，并同步开放 40 页主干 storyboard。"
  />

  <section class="section">
    <div class="section-inner split">
      <div>
        <div class="section-title">
          <p class="section-label">Build Method</p>
          <h2>课程主线优先，借鉴 AI_MD 的 book map 与校验方法</h2>
          <p>
            本教材保留现有 Astro 站点，不迁移到 MkDocs。内容映射记录在 <code>course/textbook/coursebook_map.yml</code>，
            页面数据来自 <code>site/src/data/coursebook.ts</code>；素材分层记录在 <code>docs/course_material_week_alignment_2026-06-04.md</code>。
            <code>knowledge/</code> 只作为支持层，不覆盖 <code>course/syllabus/</code> 与 <code>course/weeks/</code>。
          </p>
        </div>
        <div class="metric-row" aria-label="教材建设状态">
          <div class="metric-card">
            <strong>{totalChapters}</strong>
            <span>章课程骨架</span>
          </div>
          <div class="metric-card">
            <strong>{sampleCount}</strong>
            <span>个样章/试讲入口</span>
          </div>
          <div class="metric-card">
            <strong>Local</strong>
            <span>本地构建优先</span>
          </div>
        </div>
        <p>
          <a class="text-link" href={withBase('/coursebook/review')}>打开 Storyboard 人工精修审核台</a>
        </p>
      </div>
      <article class="info-panel">
        <h2>状态解释</h2>
        <ul class="content-list">
          <li><strong>状态词典：</strong><code>docs/course_status_dictionary.md</code> 统一解释 `textbook_status`、`ppt_status` 和 `review_status` 三条状态轴。</li>
          <li><strong>目录占位：</strong>只表示已登记教材章节和来源，不表示正文完成。</li>
          <li><strong>全书初稿：</strong>表示已有 Markdown 章节正文和可入库素材资产，但仍需后续精修和人工复核。</li>
          <li><strong>教材扩写稿：</strong>表示章节正文已按 40 页主干 storyboard 同步扩写，适合继续精修和后续 PPTX 裁剪。</li>
          <li><strong>样章候选：</strong>表示页面可读，但仍需补齐 evidence review、教学素材或 PPT 生产检查。</li>
          <li><strong>试点候选：</strong>表示 storyboard 与 evidence review 已通过，可进入试讲或 PPTX 设计前置准备。</li>
          <li><strong>样章可读：</strong>表示页面具备导入问题、目标、概念、案例、AI 边界、来源和 PPT 衔接。</li>
          <li><strong>PPT 状态：</strong>独立记录 storyboard、evidence review、PPTX 和视觉 QA，不由讲稿状态自动推导；当前 18 周为 <code>storyboard_expanded</code>。</li>
          <li><strong>审核入口：</strong><a class="text-link" href={withBase('/coursebook/review')}>Storyboard 人工精修审核台</a> 用于检查 Student action、Timing 和去模板化风险。</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Status Pipeline</p>
        <h2>状态流水线</h2>
        <p>
          Coursebook 状态采用显式流水线：
          <code>catalog_only</code> -> <code>textbook_full_draft</code> -> <code>textbook_expanded_draft</code> -> <code>sample_candidate</code> -> <code>pilot_candidate</code> -> <code>pilot_ready</code> -> <code>sample_ready</code> -> <code>storyboard</code> -> <code>storyboard_expanded</code> -> <code>evidence_review_assets_pending</code> -> <code>evidence_review_pass</code> -> <code>pptx_trial_done</code>。
          当前 18 周统一推进到 <code>storyboard_expanded</code>：表示 40 页主干源稿完成，不表示 PPTX 或视觉 QA 完成。
        </p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Readable Samples</p>
        <h2>样章与候选样章</h2>
        <p>样章来自当前样板周和 Week 13 试讲就绪章；所有章节已开放扩写稿和 40 页主干 storyboard，适合继续积累代码、样例、知识图谱和示意图。</p>
      </div>
      <div class="chapter-grid">
        {sampleChapters.map((chapter) => (
          <a class="chapter-card" href={withBase(chapter.page)}>
            <span class="week-kicker">Week {String(chapter.week).padStart(2, '0')}</span>
            <h3>{chapter.title}</h3>
            <p>{chapter.summary}</p>
            <div class="status-row">
              <span class="status-pill">{chapter.reviewStatus}</span>
              <span class="status-pill">{chapter.pptStatus}</span>
              {chapter.badges?.map((badge) => <span class="status-pill accent">{badge}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Chapter Map</p>
        <h2>18 章教材映射</h2>
        <p>每章固定绑定一个周次，来源以周次三件套、教材扩写稿和 40 页 storyboard 为准。18 章均可打开，样章仅表示审查深度更高。</p>
      </div>
      <div class="chapter-table-wrap">
        <table class="data-table chapter-table">
          <thead>
            <tr>
              <th>章</th>
              <th>周次</th>
              <th>标题</th>
              <th>教材状态</th>
              <th>审查状态</th>
              <th>PPT 状态</th>
              <th>入口</th>
            </tr>
          </thead>
          <tbody>
            {coursebookChapters.map((chapter) => (
              <tr id={`week-${String(chapter.week).padStart(2, '0')}`}>
                <td>{chapter.chapter}</td>
                <td>Week {String(chapter.week).padStart(2, '0')}</td>
                <td>
                  <strong>{chapter.title}</strong>
                  <p>{chapter.summary}</p>
                  {chapter.badges && (
                    <div class="inline-badges">
                      {chapter.badges.map((badge) => <span class="status-pill accent">{badge}</span>)}
                    </div>
                  )}
                </td>
                <td><span class="status-pill">{chapter.status}</span></td>
                <td><span class="status-pill">{chapter.reviewStatus}</span></td>
                <td><span class="status-pill">{chapter.pptStatus}</span></td>
                <td>
                  <a class="text-link" href={withBase(chapter.page)}>{chapter.sample ? '打开样章' : '打开初稿'}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
