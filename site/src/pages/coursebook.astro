---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { textbookChapters, sampleChapters } from '../data/coursebook';
import { withBase } from '../lib/paths';

const totalChapters = textbookChapters.length;
const sampleCount = sampleChapters.length;
---

<BaseLayout title="Coursebook" description="医药数据处理与可视化在线教材目录">
  <PageHeader
    eyebrow="Coursebook"
    title="在线教材目录"
    intro="Coursebook 是教材章节和知识体系入口，服务课前预习、课后复习、概念归纳和素材资产追踪。周次教学计划与 storyboard 审核已迁移到 Courseware / Teaching Plan。"
  />

  <section class="section">
    <div class="section-inner split">
      <div>
        <div class="section-title">
          <p class="section-label">Build Method</p>
          <h2>教材主线优先，保留周次映射和资产索引</h2>
          <p>
            本教材保留现有 Astro 站点，不迁移到 MkDocs。内容映射记录在 <code>course/textbook/coursebook_map.yml</code>，
            页面数据拆分为 <code>textbookChapters</code> 与 <code>coursewareWeeks</code>。本页只展示教材章节、知识体系、素材资产和章节状态；
            <code>knowledge/</code> 只作为支持层，不覆盖 <code>course/syllabus/</code> 与 <code>course/weeks/</code>。
          </p>
        </div>
        <div class="metric-row" aria-label="教材建设状态">
          <div class="metric-card">
            <strong>{totalChapters}</strong>
            <span>章课程骨架</span>
          </div>
          <div class="metric-card">
            <strong>{sampleCount}</strong>
            <span>个样章/试讲入口</span>
          </div>
          <div class="metric-card">
            <strong>Local</strong>
            <span>本地构建优先</span>
          </div>
        </div>
        <p>
          <a class="text-link" href={withBase('/courseware')}>打开 Courseware / Teaching Plan 入口</a>
        </p>
      </div>
      <article class="info-panel">
        <h2>教材状态解释</h2>
        <ul class="content-list">
          <li><strong>状态词典：</strong><code>docs/course_status_dictionary.md</code> 统一解释 `textbook_status`、`ppt_status` 和 `review_status` 三条状态轴。</li>
          <li><strong>全书初稿：</strong>表示已有 Markdown 章节正文和可入库素材资产，但仍需后续精修和人工复核。</li>
          <li><strong>教材扩写稿：</strong>表示章节正文已改为知识体系稿，适合继续进行教材审读和概念精修。</li>
          <li><strong>样章可读：</strong>表示页面具备导入问题、目标、概念、案例、AI 边界、来源和 PPT 衔接。</li>
          <li><strong>教学计划：</strong>90 分钟课堂组织、Student action、Timing 和 storyboard 审核统一在 <a class="text-link" href={withBase('/courseware')}>Courseware</a> 中查看。</li>
          <li><strong>PPT 状态：</strong>独立记录 storyboard、evidence review、PPTX 和视觉 QA，不由教材或讲稿状态自动推导；当前 18 周为 <code>storyboard_expanded</code>。</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Dual Track</p>
        <h2>教材与课件分工</h2>
        <p>
          教材章节回答“知识体系如何组织”，教学计划回答“90 分钟怎么教”，PPT storyboard 回答“每页投屏源稿怎么呈现”。
          Coursebook 只保留教材正文、知识地图、素材资产和章节来源；逐页 storyboard 审核在 Courseware 中完成。
        </p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Readable Samples</p>
        <h2>样章与候选样章</h2>
        <p>样章来自当前样板周和 Week 13 试讲就绪章；所有章节已开放扩写稿和 40 页主干 storyboard，适合继续积累代码、样例、知识图谱和示意图。</p>
      </div>
      <div class="chapter-grid">
        {sampleChapters.map((chapter) => (
          <a class="chapter-card" href={withBase(chapter.page)}>
            <span class="week-kicker">Week {String(chapter.week).padStart(2, '0')}</span>
            <h3>{chapter.title}</h3>
            <p>{chapter.summary}</p>
            <div class="status-row">
              <span class="status-pill">{chapter.reviewStatus}</span>
              <span class="status-pill">{chapter.pptStatus}</span>
              {chapter.badges?.map((badge) => <span class="status-pill accent">{badge}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Chapter Map</p>
        <h2>18 章教材映射</h2>
        <p>每章固定绑定一个周次，来源以周次三件套、教材扩写稿和 40 页 storyboard 为准。18 章均可打开，样章仅表示审查深度更高。</p>
      </div>
      <div class="chapter-table-wrap">
        <table class="data-table chapter-table">
          <thead>
            <tr>
              <th>章</th>
              <th>周次</th>
              <th>标题</th>
              <th>教材状态</th>
              <th>审查状态</th>
              <th>PPT 状态</th>
              <th>入口</th>
            </tr>
          </thead>
          <tbody>
            {textbookChapters.map((chapter) => (
              <tr id={`week-${String(chapter.week).padStart(2, '0')}`}>
                <td>{chapter.chapter}</td>
                <td>Week {String(chapter.week).padStart(2, '0')}</td>
                <td>
                  <strong>{chapter.title}</strong>
                  <p>{chapter.summary}</p>
                  {chapter.badges && (
                    <div class="inline-badges">
                      {chapter.badges.map((badge) => <span class="status-pill accent">{badge}</span>)}
                    </div>
                  )}
                </td>
                <td><span class="status-pill">{chapter.status}</span></td>
                <td><span class="status-pill">{chapter.reviewStatus}</span></td>
                <td><span class="status-pill">{chapter.pptStatus}</span></td>
                <td>
                  <a class="text-link" href={withBase(chapter.page)}>{chapter.sample ? '打开样章' : '打开教材'}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
