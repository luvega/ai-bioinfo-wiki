---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const chapters = [
  ['Foundations', '医药数据类型、可复现分析、AI 协作边界、工具分工。'],
  ['Programming', 'Python、R、Bash、Biopython、数据框和 pipeline 直觉。'],
  ['Statistics', '描述统计、统计推断、相关、线性回归、逻辑回归和模型评价。'],
  ['Visualization', '分布图、箱线图、科研图表规范、图注写作和图表导出。'],
  ['Omics', '高维数据、RNA-seq、差异表达、功能富集和单细胞可视化。'],
  ['Cases', '数据清洗、火山图、热图、UMAP、AI 输出审计和综合项目案例。']
];
---

<BaseLayout title="Coursebook" description="不受课堂时间限制的课程教材规划">
  <PageHeader
    eyebrow="Coursebook"
    title="扩展课程教材"
    intro="Coursebook 以 18 周课堂为骨架，但内容不受课堂时间限制。它会逐步吸收本项目所有可用参考资源、知识页、概念页和编程案例。"
  />

  <section class="section">
    <div class="section-inner split">
      <div>
        <div class="section-title">
          <p class="section-label">Principle</p>
          <h2>课堂节奏与教材深度分离</h2>
          <p>
            课堂页面回答“本周怎么教、怎么练、怎么核验”。Coursebook 回答“这个主题还可以深入到哪里、有哪些概念、案例和参考资源可以继续学习”。
          </p>
        </div>
        <a class="button" href="/resources">从资源索引开始整理</a>
      </div>
      <figure class="image-panel">
        <img src="/assets/sysu/campus-wide.jpeg" alt="中山大学校园照片" />
      </figure>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <div class="section-title">
        <p class="section-label">Structure</p>
        <h2>建议章节结构</h2>
      </div>
      <div class="coursebook-grid">
        {chapters.map(([title, text]) => (
          <article class="coursebook-card">
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
